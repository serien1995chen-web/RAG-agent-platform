{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "KB_TEST_MONGO_URI",
    "KB_TEST_MONGO_FULLTEXT_URI",
    "KB_TEST_MONGO_INDEX_URI",
    "KB_TEST_PG_URL",
    "KB_TEST_REDIS_URL",
    "KB_TEST_S3_ENDPOINT",
    "KB_TEST_S3_REGION",
    "KB_TEST_S3_ACCESS_KEY",
    "KB_TEST_S3_SECRET_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "build:workers": {
      "dependsOn": ["^build"],
      "outputs": ["dist/workers/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
