{
  "name": "@kb/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests test/unit",
    "test:integration": "vitest run --passWithNoTests test/integration",
    "test:contract": "vitest run --passWithNoTests test/contract",
    "lint": "eslint src"
  },
  "dependencies": {
    "@kb/chunk": "workspace:*",
    "@kb/contracts": "workspace:*",
    "@node-rs/jieba": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "mongoose": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "mongodb-memory-server": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
