{
  "name": "@kb/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knowledge:typecheck": "tsc -p tsconfig.knowledge.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests test/unit",
    "test:integration": "vitest run --passWithNoTests test/integration",
    "test:contract": "vitest run --passWithNoTests test/contract",
    "lint": "eslint src"
  },
  "dependencies": {
