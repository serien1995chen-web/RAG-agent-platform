    "@node-rs/jieba": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "axios": "catalog:",
    "bullmq": "catalog:",
    "form-data": "catalog:",
    "http-proxy-agent": "catalog:",
    "https-proxy-agent": "catalog:",
    "ioredis": "catalog:",
    "ipaddr.js": "catalog:",
    "jsonpath-plus": "catalog:",
    "mongoose": "catalog:",
    "multer": "catalog:",
    "openai": "catalog:",
    "pg": "catalog:",
    "proxy-addr": "catalog:",
    "proxy-agent": "catalog:",
    "proxy-from-env": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
