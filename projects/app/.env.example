# 本地开发占位值，禁止用于生产。业务代码不得直接读取这些变量，统一由配置层解析。
APP_WORKER_MODE=all
KB_INSTANCE_ID=local-1
KB_DEPENDENCY_BASELINE_ID=kb-baseline-6.1
KB_VERSION_CHECK_POLICY=degraded
KB_MONGO_URI=mongodb://127.0.0.1:27017/rag_agent_platform
KB_REDIS_URL=redis://127.0.0.1:6379
KB_PG_URL=postgresql://kb:kb_dev_password@127.0.0.1:5432/kb
KB_S3_ENDPOINT=http://127.0.0.1:9000
KB_S3_REGION=us-east-1
KB_S3_BUCKET=kb-local
KB_S3_ACCESS_KEY_REF=env:MINIO_ROOT_USER
KB_S3_SECRET_KEY_REF=env:MINIO_ROOT_PASSWORD
KB_OTEL_EXPORTER_ENDPOINT_REF=
