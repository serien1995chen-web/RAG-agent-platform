# Local development values only. Replace every credential before shared use.
KB_ENV=development
KB_APP_WORKER_MODE=all
KB_PORT=3010
KB_INSTANCE_ID=local-1

KB_MONGO_URI=mongodb://127.0.0.1:27017/rag_agent_platform
KB_REDIS_URL=redis://127.0.0.1:6379/0
KB_PG_URL=postgresql://kb:kb_dev_password@127.0.0.1:5432/kb
KB_S3_ENDPOINT=http://127.0.0.1:9000
KB_S3_REGION=us-east-1
KB_S3_BUCKET=kb-local
KB_S3_ACCESS_KEY_REF=env:MINIO_ROOT_USER
KB_S3_SECRET_KEY_REF=env:MINIO_ROOT_PASSWORD
KB_CITATION_SIGNING_SECRET_REF=env:KB_CITATION_SIGNING_SECRET
KB_CITATION_SIGNING_SECRET=local-citation-signing-secret-32-bytes-minimum
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

KB_AUTH_MODE=mock
KB_MOCK_AUTH_TOKEN=kb-dev-console-token-0000000000
KB_MOCK_WORKSPACE_ID=ws_local
KB_MOCK_MEMBER_ID=mem_local_owner
KB_MOCK_SCOPES=knowledge:read,knowledge:write,knowledge:manage,knowledge:admin
KB_MOCK_WORKSPACE_OWNER=true

KB_EXTERNAL_MODEL_MODE=mock
KB_EXTERNAL_OCR_MODE=mock
KB_EXTERNAL_CONNECTOR_MODE=mock

AIPROXY_MODE=compose
AIPROXY_BASE_URL=http://127.0.0.1:3001
AIPROXY_API_TOKEN_REF=env:AIPROXY_API_TOKEN
AIPROXY_POSTGRES_URI_REF=env:AIPROXY_POSTGRES_URI
AIPROXY_API_TOKEN=kb-local-aiproxy-token
AIPROXY_POSTGRES_URI=postgresql://aiproxy:aiproxy_dev_password@127.0.0.1:5433/aiproxy

KB_LOG_LEVEL=info

# AIProxy, OCR, Feishu, Yuque and DingTalk remain EXTERNAL_UNVERIFIED.
