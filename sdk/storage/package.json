{
  "name": "@kb/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./object-store-contract": "./src/object-store-contract.ts",
    "./providers/minio": "./src/providers/minio.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests test/unit",
    "test:integration": "vitest run --passWithNoTests test/integration",
    "test:contract": "vitest run --passWithNoTests test/contract",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@kb/contracts": "workspace:*",
    "ali-oss": "catalog:",
    "cos-nodejs-sdk-v5": "catalog:",
    "es-toolkit": "catalog:",
    "mime": "catalog:",
    "minio": "catalog:"
  },
  "devDependencies": {
    "@types/ali-oss": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
