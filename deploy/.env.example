# Local Compose values only. Replace all development credentials before any
# shared or production deployment.
KB_ENV=development
KB_INSTANCE_ID=compose-1

POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_dev_password
POSTGRES_DB=kb
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

KB_MONGO_DATABASE=rag_agent_platform
KB_REDIS_DATABASE=0
KB_S3_VENDOR=minio
KB_S3_ENDPOINT=http://minio:9000
KB_S3_REGION=us-east-1
KB_S3_BUCKET=kb-local
KB_S3_ACCESS_KEY_REF=env:MINIO_ROOT_USER
KB_S3_SECRET_KEY_REF=env:MINIO_ROOT_PASSWORD
KB_FILE_PUBLIC_BASE_URL=http://localhost:3010
KB_FILE_TICKET_SECRET_REF=env:KB_FILE_TICKET_SECRET
KB_FILE_TICKET_SECRET=local-file-ticket-secret-32-bytes-minimum
KB_CREDENTIAL_ENCRYPTION_KEY_REF=env:KB_CREDENTIAL_ENCRYPTION_KEY
KB_CREDENTIAL_ENCRYPTION_KEY=local-credential-key-32-bytes-minimum

KB_AUTH_MODE=mock
KB_MOCK_AUTH_TOKEN=kb-dev-console-token-0000000000
KB_MOCK_WORKSPACE_ID=ws_compose_local
KB_MOCK_MEMBER_ID=mem_compose_owner
KB_MOCK_SCOPES=knowledge:read,knowledge:write,knowledge:manage,knowledge:admin
KB_MOCK_WORKSPACE_OWNER=true
API_KEY_HMAC_SECRET_FILE=/run/secrets/api-key-hmac
KB_USAGE_PRICING_PROFILE=zero-v1
KB_QUOTA_PROFILE=free-v1

KB_EXTERNAL_MODEL_MODE=mock
KB_EXTERNAL_OCR_MODE=mock
KB_EXTERNAL_CONNECTOR_MODE=mock

AIPROXY_MODE=compose
AIPROXY_BASE_URL=http://aiproxy:3000
AIPROXY_API_TOKEN_REF=env:AIPROXY_API_TOKEN
AIPROXY_POSTGRES_URI_REF=env:AIPROXY_POSTGRES_URI
AIPROXY_ADMIN_KEY=kb-local-aiproxy-admin-token
AIPROXY_API_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef
AIPROXY_POSTGRES_USER=aiproxy
AIPROXY_POSTGRES_PASSWORD=aiproxy_dev_password

KB_LOG_LEVEL=info
# Optional OTLP HTTP endpoint; leave empty for explicit no-op telemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=

# AIProxy, OCR, Feishu, Yuque and DingTalk remain EXTERNAL_UNVERIFIED until
# real credentials and providers are supplied outside this Compose baseline.
