# 知识库验收 demo 的环境模板（不含任何真实密钥）。
# 用法：把需要的值导出到当前 shell，或复制到未跟踪文件后 source。

# 应用
NODE_ENV=development
APP_WORKER_MODE=all
KB_INSTANCE_ID=kb-demo-1
KB_DEPENDENCY_BASELINE_ID=kb-baseline-6.1
KB_VERSION_CHECK_POLICY=strict
KB_ALLOW_RUNTIME_OVERRIDE=false

# 依赖地址（对应 deploy/demo/compose.demo.yml 的宿主端口）
KB_MONGO_URI=mongodb://127.0.0.1:27019/rag_demo?directConnection=true
KB_REDIS_URL=redis://127.0.0.1:6381
KB_PG_URL=postgresql://kb:kb_demo_password@127.0.0.1:5434/kb
KB_S3_ENDPOINT=http://127.0.0.1:9004
KB_S3_REGION=us-east-1
KB_S3_BUCKET=kb-demo
KB_S3_ACCESS_KEY_REF=env:MINIO_ROOT_USER
KB_S3_SECRET_KEY_REF=env:MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=kb_demo_minio
MINIO_ROOT_PASSWORD=kb_demo_minio_password

# 开发态身份（必须为 24 位 ObjectId 形状）
KB_DEV_TEAM_ID=0000000000000000000000d1
KB_DEV_TMB_ID=0000000000000000000000d2

# 超时与容量
KB_CONNECT_TIMEOUT_MS=5000
KB_REQUEST_TIMEOUT_MS=2000
KB_MONGO_POOL_SIZE=10
KB_REDIS_CONNECTIONS=2
KB_PG_POOL_SIZE=10
KB_S3_CONCURRENCY=4
KB_PROVIDER_CONCURRENCY=4
KB_BATCH_SIZE=100
KB_QUEUE_CONCURRENCY=4
KB_PROVIDER_TIMEOUT_MS=30000
KB_PROVIDER_MAX_RETRIES=3
KB_LOG_LEVEL=info

# 外部依赖模式：无真实模型时可保持 mock（embedding 仍需真实 Provider）
KB_EXTERNAL_MOCK_MODE={"auth":"mock","model":"mock","capacity":"mock","pdfProvider":"mock","backup":"mock"}

# demo 前端展示用（构建/启动时注入）
NEXT_PUBLIC_DEMO_BASELINE_COMMIT=unknown
NEXT_PUBLIC_DEMO_BASELINE_BRANCH=feat/kb-demo-ui
NEXT_PUBLIC_DEMO_WORKER_MODE=all
NEXT_PUBLIC_DEMO_IDENTITY=0000000000000000000000d1/0000000000000000000000d2
