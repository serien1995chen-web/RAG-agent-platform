{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@kb/contracts": ["./packages/contracts/src/index.ts"],
      "@kb/service": ["./packages/service/src/index.ts"],
      "@kb/parse": ["./packages/parse/src/index.ts"],
      "@kb/chunk": ["./packages/chunk/src/index.ts"],
      "@kb/qa": ["./packages/qa/src/index.ts"],
      "@kb/search": ["./packages/search/src/index.ts"],
      "@kb/acl": ["./packages/acl/src/index.ts"],
      "@kb/dal": ["./packages/dal/src/index.ts"],
      "@kb/web": ["./packages/web/src/index.ts"],
      "@kb/storage": ["./sdk/storage/src/index.ts"],
      "@kb/otel": ["./sdk/otel/src/index.ts"],
      "@kb/app": ["./projects/app/src/index.ts"]
    }
  }
}
